# Скопируйте этот файл в .env и заполните значения для вашего окружения.

APP_SECRET_KEY=change-me-to-a-random-secret-string
APP_DEBUG=1
APP_ALLOWED_HOSTS=*

# APP_USE_SQLITE=1 включает SQLite вместо PostgreSQL — удобно для
# быстрой локальной проверки без установки СУБД. Для сдачи проекта
# по заданию должен использоваться PostgreSQL (закомментируйте/уберите
# эту переменную или установите в 0).
APP_USE_SQLITE=0
APP_DB_NAME=cloud_storage
APP_DB_USER=cloud_storage_user
APP_DB_PASSWORD=cloud_storage_password
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432

APP_STORAGE_ROOT=./storage_data
APP_MAX_UPLOAD_SIZE=209715200

APP_ADMIN_LOGIN=admin
APP_ADMIN_PASSWORD=Admin123!
APP_ADMIN_EMAIL=admin@example.com

APP_CORS_ORIGINS=http://localhost:5173

# Файл окружения для production (reg.ru).
# На сервере: cp deploy/.env.production .env   и замените три значения,
# помеченные <...> (см. backend/README.md, шаг 5).

# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
APP_SECRET_KEY=<СЛУЧАЙНАЯ_СТРОКА>
APP_DEBUG=0

# IP-адрес сервера и/или домен через запятую, без http:// и пробелов
APP_ALLOWED_HOSTS=<IP_СЕРВЕРА>,localhost,127.0.0.1

APP_USE_SQLITE=0
APP_DB_NAME=cloud_storage
APP_DB_USER=cloud_storage_user
# Тот же пароль, что задан в команде CREATE USER (шаг 3)
APP_DB_PASSWORD=<ПАРОЛЬ_БД>
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432

APP_STORAGE_ROOT=/opt/cloud-storage/backend/storage_data
APP_MAX_UPLOAD_SIZE=209715200

# Администратор создаётся при первом `migrate`.
# Пароль: не менее 6 символов, заглавная буква, цифра и спецсимвол.
APP_ADMIN_LOGIN=admin
APP_ADMIN_PASSWORD=Admin123!
APP_ADMIN_EMAIL=admin@example.com

# Фронтенд отдаётся тем же сервером, CORS не требуется
APP_CORS_ORIGINS=

# Заполняются только при включении HTTPS (шаг 11):
# APP_CSRF_TRUSTED_ORIGINS=https://example.ru
# APP_SECURE_COOKIES=1
